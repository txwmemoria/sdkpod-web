[Unit]
Description=SDK Pods studio website
Documentation=https://sdkpods.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sdkpods
Group=sdkpods
WorkingDirectory=/opt/sdkpods
Environment=SDKPODS_ROOT=/opt/sdkpods
Environment=SDKPODS_DOMAIN=sdkpods.com
Environment=SDKPODS_HTTP_PORT=80
Environment=SDKPODS_HTTPS_PORT=443
Environment=SDKPODS_AUTO_TLS=0
Environment=SDKPODS_CERT=/opt/sdkpods/certs/sdkpods.com.crt
Environment=SDKPODS_KEY=/opt/sdkpods/certs/sdkpods.com.key
Environment=SDKPODS_LOG_JSON=1
Environment=RUST_LOG=info,sdkpods=info,tower_http=info
ExecStart=/opt/sdkpods/bin/sdkpods
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/sdkpods/certs /var/log/sdkpods
ReadOnlyPaths=/opt/sdkpods/content /opt/sdkpods/static /opt/sdkpods/downloads

[Install]
WantedBy=multi-user.target
